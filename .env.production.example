# ==============================================================================
# SHRI HARIDUTT AYURVEDIC MEDICAL COLLEGE & HOSPITAL
# PRODUCTION ENVIRONMENT CONFIGURATION (HOSTINGER / CLOUD DEPLOYMENT)
# ==============================================================================

# 1. Database Configuration
# Local SQLite (Hostinger Node.js supported) or Hostinger Cloud MySQL:
DATABASE_URL="file:./dev.db"
# Or for Remote MySQL:
# DATABASE_URL="mysql://u123456789_shamc:StrongPassword@127.0.0.1:3306/u123456789_shamc_db"

# 2. Authentication & JWT Security (Generate a 64+ char random hex string)
JWT_SECRET="generate-a-strong-random-64-character-jwt-secret-in-production"

# 3. Canonical Domain
NEXT_PUBLIC_APP_URL="https://hariduttayurveda.edu.in"

# 4. Institutional Mail Dispatcher (Hostinger Titan Mail / cPanel SMTP)
SMTP_HOST="smtp.titan.email"
SMTP_PORT="465"
SMTP_USER="admissions@hariduttayurveda.edu.in"
SMTP_PASS="YourSecureSmtpPasswordHere"
SMTP_FROM="Shri Haridutt Ayurvedic Medical College <admissions@hariduttayurveda.edu.in>"
ADMIN_NOTIFICATION_EMAIL="admissions@hariduttayurveda.edu.in"

# 5. Production Node Environment
NODE_ENV="production"
PORT=3000
