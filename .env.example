# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production / Vercel Prisma Postgres (Provided automatically by Vercel Integration):
# DATABASE_URL="postgres://default:YOUR_PASSWORD@ep-sample-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgres://default:YOUR_PASSWORD@ep-sample.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. MANDATORY AUTHENTICATION SECURITY
# ------------------------------------------------------------------------------
# Required in production: Minimum 32 cryptographically secure characters.
# Generate via: openssl rand -base64 32
JWT_SECRET="replace-with-minimum-32-character-cryptographic-random-secret"

# ------------------------------------------------------------------------------
# 3. APPLICATION & HOSTING METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://www.shrihariduttayurvediccollege.org"
ADMIN_NOTIFICATION_EMAIL="admissions@hariduttayurveda.edu.in"

# ------------------------------------------------------------------------------
# 4. OPTIONAL SMTP EMAIL DISPATCH (Admissions, OTP & Contact Form Alerts)
# ------------------------------------------------------------------------------
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_USER="noreply@hariduttayurveda.edu.in"
# SMTP_PASS="YourSecureSmtpPasswordHere"
